# ---------------------------------------------------------------------------
# PaperLens — environment template
#
# Copy to `.env.local` and fill in. Every variable below is declared in exactly
# one place — `src/config/env.server.ts` or `src/config/env.client.ts` — and is
# parsed by zod at module load. A missing or malformed value fails the process
# at boot with the variable named, rather than surfacing as `undefined` inside
# a URL three layers down.
#
# Nothing outside `src/config/` may read `process.env`. That rule is enforced by
# ESLint, not by convention, and it is why this file is the complete list.
# ---------------------------------------------------------------------------

# --- Server (private) ------------------------------------------------------
# Never prefixed with NEXT_PUBLIC_. `src/config/env.server.ts` imports
# `server-only`, so importing it from a Client Component is a build error.

# Absolute origin for server-rendered absolute URLs and outbound links.
APP_URL=http://localhost:3000

# Signing key for anything this app issues itself — the session cookie MAC and
# the CSRF token. 32 bytes minimum: shorter keys make an HMAC forgeable in
# practice, not just in theory. Optional in development so a fresh clone runs
# with no setup; REQUIRED in production, including during `next build`, which
# runs with NODE_ENV=production.
#
#   openssl rand -base64 32
APP_SECRET=

# Logging. Both optional — unset means "use the environment's default":
# everything in development, info and above in production; pretty output for a
# terminal, one JSON object per line for a log aggregator.
# LOG_LEVEL=debug
# LOG_FORMAT=pretty

# Outbound HTTP defaults, centralized so no call site invents its own timeout.
# HTTP_TIMEOUT_MS=15000
# HTTP_MAX_RETRIES=2

# Comma-separated origins the HTTP client may call. Empty means allow all,
# which is the correct default only because nothing outbound is wired yet.
# This is the web's answer to certificate pinning: an egress allowlist that a
# compromised dependency cannot talk around.
# HTTP_ALLOWED_ORIGINS=https://api.example.com

# White-label tenant this deployment serves. See `src/config/tenant.ts` — the
# tenant supplies product name, tagline, theme token overrides and flag
# defaults, so one build serves many brands.
TENANT_ID=default

# --- Client (public) -------------------------------------------------------
# Inlined into the JavaScript bundle at build time and visible to anyone who
# opens devtools. A "secret" with a NEXT_PUBLIC_ prefix is a secret in a text
# file on a stranger's laptop.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# local | development | preview | staging | production
NEXT_PUBLIC_APP_ENV=local

# Usually injected by the deployment platform. Shown on the health endpoint and
# attached to every log line and error report, so a screenshot identifies the
# build it came from.
# NEXT_PUBLIC_COMMIT_SHA=

# Master switch for analytics. Off by default so a fork of this repo does not
# start emitting events to a stranger's project. Consent is still enforced
# separately, in the analytics facade.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Crash reporting endpoint. Unset means the logger-backed reporter, which is
# not a placeholder — it is the correct default when no vendor is configured.
# NEXT_PUBLIC_ERROR_REPORTING_DSN=
