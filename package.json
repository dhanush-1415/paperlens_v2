{
  "name": "paperlens-v2.1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepare": "husky install",
    "coverage:check": "vitest run --coverage && vitest run --coverage --threshold=75"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,mjs}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.42",
    "@ai-sdk/react": "^4.0.66",
    "@google/genai": "^2.16.0",
    "@gsap/react": "^2.1.2",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "ai": "^7.0.63",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "next": "^16.3.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "resend": "^6.19.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
